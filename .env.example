# ─── LLM Provider ──────────────────────────────────────────────────
# Choose which LLM backend to use for document generation.
# Options: groq, ollama
LLM_PROVIDER=groq

# Groq API key (free tier: https://console.groq.com)
# If not set, the app falls back to an offline deterministic generator.
GROQ_API_KEY=gsk_your_api_key_here

# Groq model to use (https://console.groq.com/docs/models)
LLM_MODEL=llama-3.1-8b-instant

# Ollama (local LLM) — only used if LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=llama3

# ─── SMTP / Email Delivery ─────────────────────────────────────────
# Optional — if not configured, email requests fail gracefully
# and the document is still generated successfully.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Your Name <your.email@gmail.com>
# SMTP_USE_TLS=true

# ─── Server ─────────────────────────────────────────────────────────
# Host and port for the uvicorn server (when using python run.py)
HOST=0.0.0.0
PORT=8000
